    "@effect/platform-bun": "4.0.0-rc.111",
    "@opentui/core": "0.5.6",
    "@opentui/react": "0.5.6",
    "effect": "4.0.0-rc.111",
    "react": "^19.2.8",
    "scheduler": "^0.27.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.36.5",
    "@effect/vitest": "4.0.0-rc.111",
    "@types/bun": "^1.3.6",
    "@types/react": "^19.2.18",
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7",
    "oxfmt": "^0.64.0",
    "oxlint": "1.78.0",
    "oxlint-tsgolint": "7.0.2001",
    "react-devtools-core": "^7.0.1",
    "tsx": "^4.21.0",
    "typescript": "7.0.2",
    "vitest": "^4.1.10"
